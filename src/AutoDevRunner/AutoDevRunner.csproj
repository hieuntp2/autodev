<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AutoDevRunner</RootNamespace>
    <AssemblyName>AutoDevRunner</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Headless: no console window when launched by Task Scheduler/logon.
         Observability comes from the file log (logs/autodev-*.log) and the dashboard. -->
    <OutputType Condition="'$(OS)' == 'Windows_NT'">WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <!-- Ship the global skill store next to the exe (publish/AutoDevSkills) so the
       SkillRegistry finds it at runtime and the CLI can run the skill scripts.
       Sample output is excluded to keep the deploy lean; it stays in source. -->
  <ItemGroup>
    <Content Include="..\..\AutoDevSkills\**\*"
             Exclude="..\..\AutoDevSkills\**\samples\**;..\..\AutoDevSkills\**\__pycache__\**">
      <Link>AutoDevSkills\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "File": {
      "Enabled": true,
      "Directory": "logs",
      "MinLevel": "Information"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=autodev;Username=postgres;Password=123456"
  },
  "AutoDev": {
    "Scheduler": {
      "Enabled": false,
      "IntervalHours": 2,
      "RunOnStartup": true
    },

    "Providers": {
      "Codex": {
        "Enabled": true,
        "Command": "codex",
        "Arguments": "exec --skip-git-repo-check --sandbox danger-full-access --json -m gpt-5.6-sol",
        "ResumeArguments": "exec resume {SESSION_ID} --skip-git-repo-check --sandbox danger-full-access --json -m gpt-5.6-sol",
        "Tiers": {
          "Light": "exec --skip-git-repo-check --sandbox danger-full-access --json -m gpt-5.5 -c model_reasoning_effort=low",
          "Standard": "exec --skip-git-repo-check --sandbox danger-full-access --json -m gpt-5.6-sol -c model_reasoning_effort=medium",
          "Deep": "exec --skip-git-repo-check --sandbox danger-full-access --json -m gpt-5.6-sol -c model_reasoning_effort=high"
        }
      },
      "Claude": {
        "Enabled": false,
        "Command": "claude",
        "Arguments": "-p --permission-mode bypassPermissions --output-format stream-json --verbose",
        "ResumeArguments": "-p --resume {SESSION_ID} --permission-mode bypassPermissions --output-format stream-json --verbose",
        "Tiers": {
          "Light": "-p --permission-mode bypassPermissions --output-format stream-json --verbose --model claude-haiku-4-5",
          "Standard": "-p --permission-mode bypassPermissions --output-format stream-json --verbose --model claude-sonnet-5",
          "Deep": "-p --permission-mode bypassPermissions --output-format stream-json --verbose --model claude-opus-4-8"
        }
      }
    },

    "Email": {
      "Enabled": false,
      "ApiUrl": "https://api.emailjs.com/api/v1.0/email/send",
      "ServiceId": "service_c6tdtu4",
      "TemplateId": "template_xnn6xis",
      "PublicKey": "",
      "PrivateKey": "",
      "ToEmail": "hieuntp2@gmail.com"
    },

    "BurnTokens": {
      "Enabled": false
    },

    "Prompt": {
      "MaxChars": 24000,
      "BriefMaxChars": 4000,
      "CreativePlanMaxChars": 4000,
      "ProjectGoalMaxChars": 1600,
      "RoadmapMaxChars": 900,
      "BacklogMaxChars": 900,
      "MemoryMaxChars": 700,
      "ResumeSummaryMaxChars": 4000,
      "ResumeSummaryWithLessonsMaxChars": 1200,
      "PromptDirectivesMaxChars": 1200,
      "PromptDirectivesMinChars": 400
    },

    "ModelRouting": {
      "Enabled": true
    },

    "Resume": {
      "Enabled": true,
      "MaxResumedRuns": 3,
      "ResetOnTaskChange": true
    },

    "Continuous": {
      "Enabled": false,
      "MaxUsagePercent": 95,
      "MaxRunsPerSession": 100,
      "DelayBetweenRunsSeconds": 20,
      "QuotaCooldownMinutes": 60,
      "StopAfterNoProgressRuns": 2,
      "LightTierForMaintenance": true
    },

    "Execution": {
      "IdleTimeoutMinutes": 15,
      "HeartbeatMinutes": 5
    },

    "Watchdog": {
      "Enabled": true,
      "IntervalSeconds": 60,
      "GraceMinutes": 2
    },

    "Validation": {
      "InferWhenMissing": true,
      "MaxRepairAttempts": 2,
      "JavaHome": ""
    },

    "Planner": {
      "Enabled": true,
      "SkipWhenTaskInProgress": true,
      "Model": "gpt-5.6-sol",
      "ApiKey": "",
      "ApiUrl": "https://api.openai.com/v1/responses",
      "VectorStoreIds": []
    },

    "Skills": {
      "Enabled": true,
      "Root": "",
      "AutoSelect": true,
      "ExportToProject": false,
      "Disabled": []
    },

    "ProjectMemory": {
      "AutoWriteEnabled": false
    },

    "Risk": {
      "AllowRiskyAutonomousRuns": true,
      "BlockFileDeletions": false,
      "BlockOutOfProjectChanges": true
    },

    "Learning": {
      "Enabled": true,
      "RecentRunsWindow": 5,
      "RepeatedFailureThreshold": 2
    }
  },
  "Urls": "http://localhost:5099"
}

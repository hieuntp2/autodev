# Daily Pixel Garden — autodev orchestrator configuration (OPTIONAL).
# Preferred config location is tools/autodev-orchestrator/appsettings.json (git-ignored) —
# see appsettings.example.json there. Use this .env only if you prefer env-file style.
# Precedence: process env vars > this .env file > tools/autodev-orchestrator/appsettings.json > defaults.
# NEVER commit .env (git-ignored) and NEVER set OPENAI_API_KEY as a global Windows env var.

# Required for real planning calls (leave empty + set AUTODEV_DRY_RUN=true to test without a key).
OPENAI_API_KEY=

# Cheap model for daily plans; better model for the optional Monday weekly review.
OPENAI_DAILY_MODEL=gpt-5.4-nano
OPENAI_WEEKLY_MODEL=gpt-5.4-mini
OPENAI_MAX_OUTPUT_TOKENS=2500
OPENAI_ENABLE_WEEKLY_REVIEW=false
# OPENAI_BASE_URL=https://api.openai.com/v1

# true = full loop without any OpenAI call (built-in sample plan).
AUTODEV_DRY_RUN=false

# true = `run` launches the implementer command below after writing NEXT_IMPLEMENTER_PROMPT.md.
# {PROMPT_FILE} is replaced with the absolute path of docs/autodev/NEXT_IMPLEMENTER_PROMPT.md.
AUTODEV_RUN_IMPLEMENTER=false
# Example: claude -p "Read the file {PROMPT_FILE} and execute the task exactly as described." --permission-mode acceptEdits
AUTODEV_IMPLEMENTER_COMMAND=

# Where the garden web app lives (repo-relative).
AUTODEV_GARDEN_APP_PATH=apps/daily-pixel-garden
